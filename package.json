{
  "name": "abyssinia",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b --noEmit && node scripts/build.mjs",
    "preview": "vite preview --port 4173",
    "check:seo": "npm run build && node scripts/check-seo.mjs",
    "deploy": "npm run check:seo && wrangler deploy --env \"\"",
    "dev:worker": "npm run build && wrangler d1 migrations apply DB --local --env local && wrangler dev --env local --ip 127.0.0.1 --port 8788",
    "check:cloudflare": "npm run check:seo && wrangler deploy --dry-run --env \"\"",
    "test:booking": "node tests/booking.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "@types/node": "^22.20.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "wrangler": "^4.133.0"
  },
  "engines": {
    "node": ">=22"
  }
}
