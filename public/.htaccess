# Apache 2.4 static hosting. Requires mod_rewrite and AllowOverride FileInfo.
DirectoryIndex index.html
ErrorDocument 404 /404.html
RewriteEngine On

# Combine canonical origin and legacy path changes into one permanent redirect.
RewriteRule ^menu/?$ https://abyssiniarestobar.pl/#menu [R=301,L,NE]
RewriteRule ^gallery/?$ https://abyssiniarestobar.pl/#room [R=301,L,NE]
RewriteRule ^contact/?$ https://abyssiniarestobar.pl/#visit [R=301,L,NE]
RewriteRule ^reservation/?$ https://abyssiniarestobar.pl/#reserve [R=301,L,NE]
RewriteRule ^about/?$ https://abyssiniarestobar.pl/#table [R=301,L,NE]
RewriteCond %{THE_REQUEST} \s/+index\.html[?\s] [NC]
RewriteRule ^index\.html$ https://abyssiniarestobar.pl/ [R=301,L]
RewriteCond %{THE_REQUEST} \s/+en/index\.html[?\s] [NC]
RewriteRule ^en/index\.html$ https://abyssiniarestobar.pl/en/ [R=301,L]
RewriteRule ^en$ https://abyssiniarestobar.pl/en/ [R=301,L]

# Run only for this domain; HTTPS must terminate at Apache for this rule.
RewriteCond %{HTTP_HOST} ^(?:www\.)?abyssiniarestobar\.pl$ [NC]
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://abyssiniarestobar.pl%{REQUEST_URI} [R=301,L,NE]
